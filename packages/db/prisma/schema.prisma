generator client {  
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 展覽
model Exhibition {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime? // 常設展/長期展沒有明確結束日期，可空
  description String?
  city        String?
  venue       String?
  location    String?
  ticketUrl   String?
  imageUrl    String?
  isFree      Boolean? // true=免費/false=收費/null=未知
  price       String? // 票價說明，格式不固定（例：「全票 380｜優待票 350」），不拆結構化
  openingHours String? // 每日開放時段，格式不固定（例：「週二至週日 10:00–18:00，週一休館」），不拆結構化

  tags        ExhibitionTag[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 主題 (動漫、療癒、科技藝術…)
model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String   // "SUBJECT" 或 "MOOD"（SQLite 不支援 enum，M6 換 PostgreSQL 時升級）

  exhibitions ExhibitionTag[]

  createdAt   DateTime @default(now())
}

// 中間表：連接展覽與主題的多對多關係
model ExhibitionTag {
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  exhibitionId String
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId        String

  @@id([exhibitionId, tagId])
}
